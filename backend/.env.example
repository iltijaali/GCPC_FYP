# Copy to .env (git-ignored) and fill in. Never commit real values.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# PostgreSQL (set DB_ENGINE=sqlite to use a local SQLite file instead; DB_SQLITE_PATH overrides its location)
DB_NAME=gcpc_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Account used to send password-reset OTPs and to email complaints to the DC.
# For Gmail, use an app password. Without these, no email is sent (complaints are still saved).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_STARTTLS=True

# Browser origins allowed to call the API (comma-separated). Defaults to the local dev servers.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
