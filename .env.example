# Settings for `docker compose up`. Copy to .env (git-ignored) and adjust:
#   cp .env.example .env && docker compose up --build

# --- Database (PostgreSQL runs in its own container) ---
POSTGRES_DB=gcpc_db
POSTGRES_USER=gcpc
POSTGRES_PASSWORD=change-me-db-password

# --- Django ---
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Ports on your machine ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Older plain-HTML frontend, only started with: docker compose --profile legacy up
LEGACY_PORT=5500
# Only if you open the app from another address (for example http://192.168.1.20:8080):
# VITE_API_URL=http://192.168.1.20:8000
# CORS_ALLOWED_ORIGINS=http://192.168.1.20:8080

# --- First-run data ---
# true = load demo users, products, orders and complaints (demo passwords: see README). Use false for real data.
SEED_DEMO_DATA=true
# Django admin account (/admin/), created on start if it does not exist yet
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# --- Email (OTP codes and complaints sent to the DC). Leave empty to send nothing. ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_STARTTLS=True
